<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalificacionesSudamericano.ViewModels"
             x:Class="CalificacionesSudamericano.Views.Componentes.MomentoCard"
             x:DataType="vm:MomentoViewModel">

    <Border Style="{StaticResource Tarjeta}">
        <VerticalStackLayout Spacing="14">

            <!-- Título con franja turquesa -->
            <HorizontalStackLayout Spacing="10">
                <BoxView WidthRequest="4" HeightRequest="22" CornerRadius="2"
                         Color="{StaticResource Turquesa}" VerticalOptions="Center" />
                <Label Text="{Binding Titulo}" FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource Marino}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Los 3 campos: UNA plantilla que se repite por cada elemento de "Campos" (como .map() en React) -->
            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Campos}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CampoNotaViewModel">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Etiqueta}" Style="{StaticResource Etiqueta}" />
                                <Label Grid.Column="1" Text="{Binding Porcentaje}" FontSize="12"
                                       FontAttributes="Bold" TextColor="{StaticResource Turquesa}" />
                            </Grid>

                            <Border Style="{StaticResource Campo}">
                                <!-- Si el campo tiene error, el borde se pone rojo -->
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding TieneError}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource ColorError}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Entry Text="{Binding Texto}" Placeholder="1 - 100" Keyboard="Numeric" />
                            </Border>

                            <Label Text="{Binding Error}" IsVisible="{Binding TieneError}"
                                   Style="{StaticResource TextoError}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Nota del momento, en vivo -->
            <BoxView HeightRequest="1" Color="#E5E9F0" />
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Nota del momento" Style="{StaticResource Etiqueta}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding NotaTexto}" FontSize="24"
                       FontAttributes="Bold" TextColor="{StaticResource Marino}" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>